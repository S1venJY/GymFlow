<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:GymFlow.Mobile.Models"
    x:Class="GymFlow.Mobile.MainPage"
    Title="GymFlow">

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            Padding="20,25"
            BackgroundColor="#17202A">

            <VerticalStackLayout Spacing="5">

                <Label
                    Text="GymFlow"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Тренування та фітнес в одному застосунку"
                    FontSize="14"
                    TextColor="#BFC9CA" />

            </VerticalStackLayout>

        </Border>


        <Grid
            Grid.Row="1"
            Padding="16">

            <VerticalStackLayout
                x:Name="LoadingBlock"
                IsVisible="False"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="15">

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    IsRunning="False"
                    WidthRequest="50"
                    HeightRequest="50" />

                <Label
                    Text="Завантаження розкладу..."
                    FontSize="16"
                    TextColor="Gray" />

            </VerticalStackLayout>


            <VerticalStackLayout
                x:Name="ErrorBlock"
                IsVisible="False"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="15">

                <Label
                    Text="Не вдалося завантажити розклад"
                    FontSize="18"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Button
                    Text="Повторити"
                    Clicked="OnRetryClicked"
                    WidthRequest="160" />

            </VerticalStackLayout>


            <CollectionView
                x:Name="ClassesCollectionView"
                IsVisible="False"
                SelectionMode="None">

                <CollectionView.Header>

                    <VerticalStackLayout
                        Padding="0,0,0,15"
                        Spacing="5">

                        <Label
                            Text="Розклад тренувань"
                            FontSize="24"
                            FontAttributes="Bold" />

                        <Label
                            Text="Оберіть тренування та запишіться онлайн"
                            FontSize="14"
                            TextColor="Gray" />

                    </VerticalStackLayout>

                </CollectionView.Header>


                <CollectionView.ItemTemplate>

                    <DataTemplate
                        x:DataType="model:GymClassDto">

                        <Border
                            Margin="0,0,0,14"
                            Padding="16"
                            Stroke="#E5E7E9"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="10">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    FontAttributes="Bold" />


                                <Label
                                    Text="{Binding TrainerName, StringFormat='Тренер: {0}'}"
                                    FontSize="14"
                                    TextColor="Gray" />


                                <HorizontalStackLayout
                                    Spacing="15">

                                    <Label
                                        Text="{Binding DateText, StringFormat='📅 {0}'}"
                                        FontSize="14" />

                                    <Label
                                        Text="{Binding TimeText, StringFormat='🕐 {0}'}"
                                        FontSize="14" />

                                </HorizontalStackLayout>


                                <Label
                                    Text="{Binding PlacesText}"
                                    FontSize="14"
                                    TextColor="#2471A3" />


                                <Button
                                    Text="Записатися"
                                    CommandParameter="{Binding Id}"
                                    Clicked="OnBookClicked"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    BackgroundColor="#17202A"
                                    TextColor="White" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentPage>